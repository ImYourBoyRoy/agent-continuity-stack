{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-continuity-stack:schema:client-status:2",
  "title": "Agent Continuity Stack client status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "package",
    "package_version",
    "source_sha256",
    "client",
    "client_version",
    "operating_system",
    "scope",
    "status",
    "instruction_mode",
    "instruction_location",
    "skill_locations",
    "verified_skills",
    "rendered_sha256",
    "copied",
    "loaded",
    "smoke_passed",
    "duplicate_loading",
    "verified_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "client-status"
    },
    "package": {
      "const": "agent-continuity-stack"
    },
    "package_version": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "client": {
      "enum": [
        "codex",
        "cursor",
        "claude",
        "antigravity",
        "antigravity-cli"
      ]
    },
    "client_version": {
      "type": "string",
      "minLength": 1
    },
    "operating_system": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "user",
        "project"
      ]
    },
    "instruction_mode": {
      "enum": [
        "preserve-existing",
        "guided-additions",
        "complete-contract"
      ]
    },
    "status": {
      "enum": [
        "verified",
        "installed-unverified",
        "failed"
      ]
    },
    "instruction_location": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "skill_locations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified_skills": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "content_sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "rendered_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "copied": {
      "type": "boolean"
    },
    "loaded": {
      "type": "boolean"
    },
    "smoke_passed": {
      "type": "boolean"
    },
    "duplicate_loading": {
      "enum": [
        "none",
        "detected",
        "unverified"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
