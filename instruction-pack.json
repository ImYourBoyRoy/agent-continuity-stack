{
  "schema": 3,
  "package": "agent-continuity-stack",
  "package_version": "3.2.0",
  "source": "GLOBAL_CUSTOM_INSTRUCTIONS.md",
  "source_sha256": "d388423f4371d781e02948d109c352ba9b4a605aa4b08005eb2a1f34501dd471",
  "source_hash_definition": "sha256 of canonical UTF-8 bytes with LF line endings and no BOM",
  "encoding": "utf-8",
  "line_endings": "lf",
  "byte_order_mark": "forbidden",
  "contract_title": "Expert Agent Operating Contract",
  "required_in_package": true,
  "install_by_default": false,
  "installation_requires_explicit_opt_in": true,
  "renderable_placeholders": [
    "operator_name",
    "operator_email",
    "personal_site",
    "github_profile",
    "pypi_profile"
  ],
  "rendered_integrity": {
    "hash_algorithm": "sha256",
    "hash_record_location": "install plan, transaction receipt, ownership record, and client status",
    "package_contains_fixed_rendered_hash": false,
    "unresolved_placeholders": "forbidden"
  },
  "clients": {
    "codex": {
      "target_resolution": "resolve CODEX_HOME, then prefer AGENTS.override.md when present; otherwise AGENTS.md",
      "mode": "preserving-identified-block",
      "begin_marker": "<!-- agent-continuity-stack:begin -->",
      "end_marker": "<!-- agent-continuity-stack:end -->"
    },
    "cursor": {
      "target": "Cursor Customize > Rules > User Rules",
      "mode": "client-managed-plain-text-user-rule",
      "project_test_adapter": ".cursor/rules/expert-agent-operating-contract.mdc",
      "runtime_verification_required": true
    },
    "claude": {
      "target": "~/.claude/rules/expert-agent-operating-contract.md",
      "mode": "dedicated-user-rule",
      "project_adapter": {
        "target": "CLAUDE.md",
        "mode": "import-canonical-agents",
        "import": "@AGENTS.md"
      }
    },
    "antigravity": {
      "target": "~/.gemini/config/rules/expert-agent-operating-contract.md",
      "mode": "dedicated-global-always-on-rule",
      "frontmatter": {
        "trigger": "always_on",
        "description": "Complete Expert Agent Operating Contract; always apply."
      },
      "maximum_file_bytes": 24000,
      "maximum_aggregate_tokens": 20000
    }
  },
  "rendering_policy": {
    "profile_value_source": "explicit-user-provided-or-user-designated-profile",
    "missing_profile_fields": "remove-field",
    "empty_operator_profile_section": "remove-section",
    "infer_profile_from_git_or_repository": false
  }
}
